{
  "name": "pi-fast-local",
  "version": "0.1.11-local",
  "private": true,
  "description": "A pi extension that enables Fast mode for supported direct OpenAI API, OpenAI Codex, and Anthropic Claude models based on the currently selected model.",
  "keywords": [
    "pi-package",
    "pi",
    "openai",
    "anthropic",
    "fast"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegopetrucci/pi-extensions.git",
    "directory": "extensions/fast"
  },
  "files": [
    "index.ts",
    "fast.example.json",
    "README.md",
    ".pi-fleet-tested-version"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  }
}
